{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Provider verification result version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "standard_version", "run_id", "input_record_reference", "gateway_commit", "runtime_digest", "extension_revision", "observed_at_utc", "results", "cleanup_status"],
  "properties": {
    "schema_version": {"const": 1},
    "standard_version": {"const": 1},
    "run_id": {"type": "string", "format": "uuid"},
    "input_record_reference": {"type": "string", "minLength": 1, "maxLength": 256},
    "gateway_commit": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
    "runtime_digest": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
    "extension_revision": {"type": ["string", "null"], "maxLength": 128},
    "observed_at_utc": {"type": "string", "format": "date-time"},
    "cleanup_status": {"enum": ["not_started", "completed", "failed", "not_applicable"]},
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["provider", "model_label", "scenario", "stage", "status", "reason", "duration_ms", "evidence_kind", "evidence_reference", "request_id", "submission_state", "session_persistence", "session_activation", "session_durability", "account_verdict"],
        "properties": {
          "provider": {"enum": ["chatgpt", "claude", "gemini", "grok", "metaai", "mistral", "perplexity", "qwen", "manus"]},
          "model_label": {"type": ["string", "null"], "maxLength": 128},
          "scenario": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
          "stage": {"enum": ["1.capture", "1.persist_activate", "2.1.fetch", "2.2.fill", "2.3.submit", "2.4.extract", "2.5.envelope", "2.6.deliver", "recovery"]},
          "status": {"enum": ["pass", "fail", "blocked", "unsupported"]},
          "reason": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
          "duration_ms": {"type": ["integer", "null"], "minimum": 0},
          "evidence_kind": {"enum": ["fixture", "live", "code_review", null]},
          "evidence_reference": {"type": ["string", "null"], "maxLength": 256},
          "request_id": {"type": ["string", "null"], "format": "uuid"},
          "submission_state": {"enum": ["not_sent", "acknowledged", "outcome_unknown", "not_applicable"]},
          "session_persistence": {"enum": ["unknown", "saved", "failed", "not_applicable"]},
          "session_activation": {"enum": ["unknown", "activated", "failed", "not_applicable"]},
          "session_durability": {"enum": ["unknown", "durable", "failed", "not_applicable"]},
          "account_verdict": {"enum": ["verified", "explicitly_unauthenticated", "unknown", "unsupported", "not_applicable"]}
        },
        "allOf": [{
          "if": {"properties": {"status": {"const": "pass"}}},
          "then": {
            "properties": {
              "duration_ms": {"type": "integer"},
              "evidence_kind": {"enum": ["fixture", "live", "code_review"]},
              "evidence_reference": {"type": "string", "minLength": 1}
            }
          }
        }]
      }
    }
  }
}
